[Unit]
Description=Infradapt Onboarding Tracker - reset recurring tasks whose due date has arrived
After=network.target

[Service]
Type=oneshot
User=onboarding
Group=onboarding
WorkingDirectory=/opt/onboarding-app
EnvironmentFile=/opt/onboarding-app/.env
ExecStart=/opt/onboarding-app/venv/bin/python process_recurring_tasks.py
StandardOutput=append:/var/log/onboarding-app/recurring-tasks.log
StandardError=append:/var/log/onboarding-app/recurring-tasks.error.log
