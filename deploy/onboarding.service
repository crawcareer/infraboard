[Unit]
Description=Infradapt Onboarding Tracker (gunicorn)
After=network.target

[Service]
Type=simple
User=onboarding
Group=onboarding
WorkingDirectory=/opt/onboarding-app
EnvironmentFile=/opt/onboarding-app/.env
ExecStart=/opt/onboarding-app/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 run:app
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/onboarding-app/onboarding.log
StandardError=append:/var/log/onboarding-app/onboarding.error.log

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
