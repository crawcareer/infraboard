# Copy this file to .env and fill in real values before running the app.

# Flask secret key used to sign sessions/cookies. Generate a strong random
# value in production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string. Defaults to a local SQLite file at
# instance/onboarding.db if left unset.
#SQLALCHEMY_DATABASE_URI=sqlite:///instance/onboarding.db
SQLALCHEMY_DATABASE_URI=sqlite:////opt/onboarding-app/instance/onboarding.db

# --- SMTP settings used by send_daily_summary.py -----------------------
# Works with any standard SMTP server: Office 365, Gmail (with an App
# Password), a company relay, etc.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=onboarding@yourcompany.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_USE_TLS=true
FROM_EMAIL=onboarding@yourcompany.com
